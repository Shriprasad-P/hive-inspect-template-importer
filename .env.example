# ── Persistence (required) ──────────────────────────────────────────
# Supabase / Postgres (pooled — use for the Next.js app / Vercel)
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Direct connection (migrations / prisma db push). Same password, db host:
DIRECT_URL="postgresql://USER:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# ── Optional Supabase client ────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
