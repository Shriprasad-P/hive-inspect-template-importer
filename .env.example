# ── Persistence (required) ──────────────────────────────────────────
# Default local/demo: SQLite file under /data (relative to prisma/)
DATABASE_URL="file:../data/dev.db"

# To use Supabase / Postgres:
# 1. In prisma/schema.prisma set provider = "postgresql"
# 2. Set DATABASE_URL to your pooled connection string, e.g.:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# 3. Run: npx prisma migrate deploy && npm run db:seed

# ── Optional Supabase client ────────────────────────────────────────
# When both are set, the app prefers the Supabase JS client for reads
# in places that support it. Prisma remains the write path.
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
